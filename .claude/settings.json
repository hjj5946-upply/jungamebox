{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(cat .env*)",
      "Bash(type .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(source .env*)",
      "Bash(Get-Content .env*)"
    ]
  }
}
